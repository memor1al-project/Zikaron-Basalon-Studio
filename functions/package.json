{
  "name": "zikaron-basalon-functions",
  "version": "1.0.0",
  "description": "Zikaron BaSalon - Firebase Cloud Functions",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "firebase-functions-test": "^3.3.0",
    "typescript": "^5.7.0"
  },
  "private": true
}

# Copy to .env.local and fill in. The Functions emulator loads .env.local
# automatically; .env.local is gitignored.

# Gemini API key for the AI material actions.
# Get one from: https://aistudio.google.com/app/apikey
# Read by functions/src/services/geminiMaterials.ts and
# scripts/segment-testimony-videos.mjs.
# In production, set it as a secret instead:
#   firebase functions:secrets:set GEMINI_API_KEY
GEMINI_API_KEY=
